{
  "暗色主题": {
    "基础主题": "vs-dark",
    "继承默认": true,
    "规则": [
      { "标记": "注释", "前景色": "#6A9955" },
      { "标记": "字符串", "前景色": "#CE9178" },
      { "标记": "关键字", "前景色": "#569CD6" },
      { "标记": "变量", "前景色": "#9CDCFE" },
      { "标记": "数字", "前景色": "#B5CEA8" }
    ],
    "颜色": {
      "editor.background": "#00000000"
    }
  },
  "亮色主题": {
    "基础主题": "vs",
    "继承默认": true,
    "规则": [
      { "标记": "注释", "前景色": "#008000" },
      { "标记": "字符串", "前景色": "#A31515" },
      { "标记": "关键字", "前景色": "#0000FF" },
      { "标记": "变量", "前景色": "#001080" },
      { "标记": "数字", "前景色": "#098658" }
    ],
    "颜色": {
      "editor.background": "#00000000"
    }
  },
  "分词规则": {
    "规则": [
      { "正则": "//.*$", "标记": "注释" },
      { "正则": "%[^\\n%]*%", "标记": "变量" },
      { "正则": "#[^\\n#]+#", "标记": "关键字" },
      { "正则": "\\[FL\\]", "标记": "关键字" },
      { "正则": "\\b\\d+\\b", "标记": "数字" }
    ],
    "配对": [
      { "开始": "\\$", "结束": "\\$", "标记": "关键字", "内容": ["[^$\\n]+"] },
      { "开始": "±", "结束": "±", "标记": "字符串", "内容": ["[^±\\n]+"] },
      { "开始": "\"\"\"", "结束": "\"\"\"", "标记": "字符串", "内容": ["[^\"]+", "\""] },
      { "开始": "/\\*", "结束": "\\*/", "标记": "注释", "内容": ["[^*]+", "."] }
    ]
  },
  "自定义规则": []
}
